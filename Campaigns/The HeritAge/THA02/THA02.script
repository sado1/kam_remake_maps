//The Night script
//During the game the vision periodically goes into dark
const
MAPX=255;
MAPY=255;
PP=1; //max player
RR=5;	//vision range for units
RH=10;	//vision range for house 

//spammed barbs
const

MX = 254;		//size of the map
MY = 254;		//size of the map
XA = 234;		//it has to be a walkable tile
YA = 128;		//it has to be a walkable tile
MaxX =139;		//over this X coordinat do not add barb
MaxY =137;		//over this y coordinat do not add barb
D = 7;			//unit direction
KK =15;			//repeater counter
LG = 10;		//Largest Group
//CL =1;		//unit colum type-this is actually max larger planned group


//overlay setup
INTERFACE_COLOR = 'aaaaaa';
IRON_COLOR = 'ffffb3';
LEATHER_COLOR = '3377ff';
HORSE_COLOR = '003366';
STAT_COLOR = 'ff6600';
MAP_TYPE = 0;
STATS_FOR_ALL = 0;	

var BK: array [0..64000] of Integer;	
//MKK: array [6..250] of Integer;	





//vision for allies
procedure allyvisions(G,XG,YG,RRG:integer);
var N:integer;
begin
for N:=0 to PP do begin
		if (States.PlayerAllianceCheck(G,N) = True) then 
		Actions.FogRevealCircle(N, XG, YG, RRG);
		
end;
end;

//for revealing after cover happened
procedure RevealFog();
var J, K, H,UT, HT, HTT: Integer;

begin
   for J := 0 to MAPY do
		For K:= 0 to MAPX do
   begin
		HT:= States.HouseAt(K,J);
		UT:= States.UnitAt(K,J);

				
		if UT > -1 then begin
			H:= States.UnitOwner(UT);
			Actions.FogRevealCircle(H, K, J, RR);
			//vision for ally
			allyvisions(H,K,J,RR);
			//vision for scouts
				if (States.UnitType(UT) = 21) then begin
					Actions.FogRevealCircle(H, K, J, 14);
					//vision for the allies too
					allyvisions(H,K,J,14);
				end;
			end;
			
		if HT > -1 then begin
			HTT:= States.HouseOwner(HT);
			if HTT > -1 then begin
			Actions.FogRevealCircle(HTT, K, J, RH);
			//vision for the allies
			allyvisions(HTT,K,J,RH);
			//vision for towers
				if (States.HouseType(HTT) = 17) then begin
					Actions.FogRevealCircle(HTT, K, J, 15);
					//vision for the allies too
					allyvisions(HTT,K,J,15);
					end;
			end;
		
			
			end;
end;
end;

//covering all
procedure CoversAll;
var DDD:integer;
Begin
	for DDD := 0 to  (PP - 1) do
				if States.PlayerEnabled(DDD) then
				Actions.FogCoverAll(DDD);
				end;




