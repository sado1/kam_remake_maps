	if (aKiller <> -1) then
	begin
	Inc(BK[aKiller]);
	

				if (States.UnitOwner(aUnit) = 13) and (States.UnitType(aUnit) = 23) then begin
						for K := 0 to KK do
						begin
						OO := States.KamRandomI(MX);
						PPP := States.KamRandomI(MY);
						RRR := States.KamRandomI(MX);
						GG := States.KamRandomI(MY);
						KZ := States.KamRandomI(D);	
						CLY := 1+States.KamRandomI(5);
						
						BU := States.ClosestGroup(13,OO,PPP,0);
						AB := States.UnitDirection((States.ClosestUnit(13,OO,PPP,23)));
												
						if (BU > -1) then begin
							
							Actions.GroupOrderWalk(BU,(MX-RRR),(MY-GG),D);	
							end;
						//end;
						
