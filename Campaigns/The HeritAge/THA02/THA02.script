procedure OnMissionStart;
var P, XX, YY, ZZ, WW, DZ, CLX, IZ : Integer;
var IK, ID, IT, ISQ, IH, IP : Integer;
var O, H, L, K : Integer;
var CU, AD : Integer;

begin
IK := 0 ;			//single
ID := 0 ;			//duo
IT := 0 ;			//trio
ISQ := 0 ;			//squad
IH := 0 ;				//hex
IP := 0;				//dec

 for P := 0 to 13 do
  if States.PlayerEnabled(P) then
  
  //single units
  if P = 13 then begin
  for IZ:= 0 to IK do
	begin
	XX := LG + States.KamRandomI(MX);
	YY := LG + States.KamRandomI(MY);
	ZZ := LG + States.KamRandomI(MX);
	WW := LG + States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+States.KamRandomI(1);
	
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	IK := IK +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,1,CLX);
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
	end;
   end; 
   
   //group with 2 members
   for O:= 0 to ID do
	begin
	XX := (LG-2) + States.KamRandomI(MX);
	YY := (LG-2) + States.KamRandomI(MY);
	ZZ := (LG-2) + States.KamRandomI(MX);
	WW := (LG-2) + States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+States.KamRandomI(1);
		
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	ID := ID +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,2,CLX);	
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
	end;
   end;
   
 
 //group with 3 members
for L:= 0 to IT do
	begin
	XX := (LG-3) + States.KamRandomI(MX);
	YY := (LG-3) + States.KamRandomI(MY);
	ZZ := (LG-3) + States.KamRandomI(MX);
	WW := (LG-3) + States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+ States.KamRandomI(2);
	
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	IT := IT +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,3,CLX);	
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
    end;
   end;
   
   //groups with 4 members;  
   for K:= 0 to ISQ do
	begin
	XX := (LG-4) + States.KamRandomI(MX);
	YY := (LG-4) + States.KamRandomI(MY);
	ZZ := (LG-4) + States.KamRandomI(MX);
	WW := (LG-4) + States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+States.KamRandomI(3);
	
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	ISQ := ISQ +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,4,CLX);
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
	end;
   end;
   
   //groups with 6 members;  
   for H:= 0 to IH do
	begin
	XX := (LG-6) + States.KamRandomI(MX);
	YY := (LG-6) + States.KamRandomI(MY);
	ZZ := (LG-6) + States.KamRandomI(MX);
	WW := (LG-6) + States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+States.KamRandomI(5);
	
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	IH := IH +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,6,CLX);
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
	end;
   end; 
   
    //groups with 10 members;  
   for H:= 0 to IP do
	begin
	XX := States.KamRandomI(MX);
	YY := States.KamRandomI(MY);
	ZZ := States.KamRandomI(MX);
	WW := States.KamRandomI(MY);
	DZ := States.KamRandomI(D);	
	CLX := 1+States.KamRandomI(9);
	
	If (States.ConnectedByWalking(XA,YA,XX,YY) = False) or ((XX > MaxX) and (YY > MaxY)) then begin
	IH := IH +1;
	end else
	If States.ConnectedByWalking(XA,YA,XX,YY) = True then begin
	Actions.GiveGroup(P,23,XX,YY,DZ,10,CLX);
	CU := States.ClosestGroup(13,XX,YY,0);
	AD := States.UnitDirection((States.ClosestUnit(13,XX,YY,0)));
	Actions.GroupOrderWalk(CU,(MX-ZZ),(MY-WW),D);
	end;
   end; 
   
   
   
end;
end;



